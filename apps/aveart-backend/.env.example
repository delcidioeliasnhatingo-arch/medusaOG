# Copy to .env locally. Never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECRET=replace-with-a-different-long-random-secret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000
NODE_ENV=development

# Optional. Without REDIS_URL, the app uses in-memory providers for single-instance testing only.
# Configure Redis before running multiple production instances or a separate worker.
# REDIS_URL=redis://USER:PASSWORD@HOST:PORT
